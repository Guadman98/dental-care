# Copia este archivo como .env.local y completa los valores.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://jomvkqlzxezyznuitucc.supabase.co
# Clave pública ("publishable" o "anon"). Se puede exponer en el navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta ("secret" o "service_role"). SOLO servidor, nunca la compartas.
SUPABASE_SECRET_KEY=

# Correo saliente (Gmail con contraseña de aplicación). Si se dejan vacíos,
# las citas funcionan igual pero no se envían correos.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# URL pública del sitio, para los enlaces dentro de los correos.
NEXT_PUBLIC_SITIO_URL=http://localhost:3000
